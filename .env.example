# Meta Instagram API with Instagram Login Configuration
# Create a Meta App at https://developers.facebook.com/
# Add 'Instagram' product with 'Business Login for Instagram'

# Meta App Client ID
INSTAGRAM_CLIENT_ID=your_meta_app_client_id_here

# Meta App Client Secret (Keep secret! Never commit to repository)
INSTAGRAM_CLIENT_SECRET=your_meta_app_client_secret_here

# OAuth Redirect URI configured in Meta Developer App Settings
# For local development: http://localhost:3008/api/instagram/auth/callback
# For production: https://commanddeck.com/api/instagram/auth/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3008/api/instagram/auth/callback

# Master Admin Key for accessing /admin/instagram and running /api/instagram/sync
ADMIN_SECRET_KEY=change_this_to_a_secure_random_key_for_admin_access

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3008
